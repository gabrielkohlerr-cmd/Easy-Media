{
  "name": "easy-media",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --no-warnings server/index.js",
    "dev:full": "concurrently -n API,WEB -c blue,magenta \"npm:server\" \"npm:dev\"",
